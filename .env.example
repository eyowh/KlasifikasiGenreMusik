# Example Environment Variables untuk Django
# Copy file ini menjadi .env dan isi dengan nilai yang sesuai sebelum menjalankan di production.
# Jangan pernah commit file .env ke version control!

# Secret key untuk production (harus panjang, random, dan rahasia)
DJANGO_SECRET_KEY=ganti-dengan-secret-key-yang-aman

# Mode debug (set False untuk production)
DJANGO_DEBUG=True

# Domain atau IP yang diizinkan untuk mengakses aplikasi ini (pisahkan dengan koma jika ada banyak)
# Contoh: DJANGO_ALLOWED_HOSTS=example.com,www.example.com
